{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "KiranADF565"
		},
		"SQLDatabase_linkedservice_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQLDatabase_linkedservice'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfadls.dfs.core.windows.net/"
		},
		"SQLDatabase_linkedservice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-server-for-retail-data.database.windows.net"
		},
		"SQLDatabase_linkedservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Retail Data"
		},
		"SQLDatabase_linkedservice_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "kiran565"
		},
		"trigger1_properties_PL_SQL_DB_parameters_table_name": {
			"type": "string",
			"defaultValue": "products"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "KiranADF565_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"SQLDatabase_linkedservice_password": {
						"value": "[parameters('SQLDatabase_linkedservice_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"SQLDatabase_linkedservice_properties_typeProperties_server": {
						"value": "[parameters('SQLDatabase_linkedservice_properties_typeProperties_server')]"
					},
					"SQLDatabase_linkedservice_properties_typeProperties_database": {
						"value": "[parameters('SQLDatabase_linkedservice_properties_typeProperties_database')]"
					},
					"SQLDatabase_linkedservice_properties_typeProperties_userName": {
						"value": "[parameters('SQLDatabase_linkedservice_properties_typeProperties_userName')]"
					},
					"trigger1_properties_PL_SQL_DB_parameters_table_name": {
						"value": "[parameters('trigger1_properties_PL_SQL_DB_parameters_table_name')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}